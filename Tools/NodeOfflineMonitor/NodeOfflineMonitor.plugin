#!name=Node Offline Monitor
#!desc=Checks Loon nodes and notifies after confirmed outages or recoveries.
#!loon_version=3.5.1(988)
#!version=1.7.0

[Argument]
cronexp = input,"*/15 * * * *",tag=Check Schedule,desc=Cron schedule for checking nodes. Default is every 15 minutes.
test_url = input,"auto",tag=Test URL,desc=Use auto for the default connectivity-check URL.
maintenance_start = input,"",tag=Maintenance Start,desc=Start time in HH:mm using device time. Leave both times empty to disable.
maintenance_end_time = input,"",tag=Maintenance End,desc=End time in HH:mm using device time. Overnight windows are supported; use different start and end times.

[Script]
generic then script("https://raw.githubusercontent.com/kewachan/Loon/main/Tools/NodeOfflineMonitor/node-offline-monitor.js", {${test_url}, ${maintenance_start}, ${maintenance_end_time}}) with tag="Node Offline Monitor", img_url="network.badge.shield.half.filled.system", timeout=180
cron ${cronexp} then script("https://raw.githubusercontent.com/kewachan/Loon/main/Tools/NodeOfflineMonitor/node-offline-monitor.js", {${test_url}, ${maintenance_start}, ${maintenance_end_time}}) with tag="Node Offline Monitor Scheduled", timeout=180
