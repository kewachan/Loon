#!name=General AdBlock
#!desc=Unified response filtering for websites and apps
#!loon_version=3.5.1(988)

[Script]
http-response ^https:\/\/api\.gamer\.com\.tw\/(?:mobile_app\/anime\/v\d\/(?:token|m3u8)|anime\/v\d\/video_src)\.php(?:\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/GeneralAdBlock/bahamut-adblock.js?v=1.1.0,tag=Bahamut,requires-body=true,timeout=40
http-response ^https?:\/\/(www\.)?google\.[^\/]+\/search(?:\/.*)?(?:\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/GeneralAdBlock/google-adblock.js?v=1.0.19,tag=Google,requires-body=true,timeout=30
http-response ^https?:\/\/comicapi\.manhuashe\.com\/v\d\/.+?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/GeneralAdBlock/manhuashe-adblock.js?v=1.0.2,tag=Manhuashe,requires-body=true,timeout=30
http-response ^https:\/\/legy\.line-apps\.com(?::443)?\/S4(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/GeneralAdBlock/line-adblock.js?v=1.0.0,tag=LINE,requires-body=true,binary-body-mode=true,timeout=30
http-response ^https:\/\/pay\.macaupass\.com\/tdrmp\/appMenu\/getAppMenu\.do(?:\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/GeneralAdBlock/mpay-adblock.js?v=1.0.6,tag=MPay,requires-body=true,timeout=30
http-response ^https:\/\/gql(?:-fed)?\.reddit\.com(?:\/.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/GeneralAdBlock/reddit-adblock.js?v=1.0.0,tag=Reddit,requires-body=true,timeout=10
http-response ^https:\/\/service(?:\.global)?\.thim\.immigration\.go\.th\/api\/v1\/explore\/coupons\/exclusive-banners(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/GeneralAdBlock/thim-adblock.js?v=1.0.3,tag=THIM,requires-body=true,timeout=30
http-response ^https:\/\/userside-api\.mfoodapp\.com\/(?:orgs\/basic\/banner\/(?:_list_spread-compress|_special_list|_new_special_list|_list_suspend|_list_smart|bottom\/banner\/_list)|orgs\/banner\/advertisement\/(?:_get_banner_list|_get_advertisement_list|_activity_advertisement_list)|market\/user_side\/pop\/(?:_comprehensive_pop_list|getGroupPopList|_get_pop_list)|market\/user_side\/banner\/_get_banner_list|market\/market\/zone\/_new-people-ad|activity\/activity\/topPop\/list|activity\/userActivity\/getPop)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/GeneralAdBlock/mfood-adblock.js?v=1.5.1,tag=mFood,requires-body=true,timeout=30
http-request ^https:\/\/userside-api\.mfoodapp\.com\/(?:orgs\/basic\/banner\/(?:_list_spread-compress|_special_list|_new_special_list|_list_suspend|_list_smart|bottom\/banner\/_list)|orgs\/banner\/advertisement\/(?:_get_banner_list|_get_advertisement_list|_activity_advertisement_list)|market\/user_side\/pop\/(?:_comprehensive_pop_list|getGroupPopList|_get_pop_list)|market\/user_side\/banner\/_get_banner_list|market\/market\/zone\/_new-people-ad|activity\/activity\/topPop\/list|activity\/userActivity\/getPop)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/GeneralAdBlock/mfood-adblock.js?v=1.5.1,tag=mFood Request,timeout=30
http-response ^https?:\/\/(?:zh\.wikipedia\.org\/w\/load\.php\?.*modules=ext\.gadget\.VariantAllyDialog(?:&.*)?|zh\.wikipedia\.org\/w\/api\.php\?.*page=Template(?:%3A|:)AdvancedSiteNotices(?:%2F|\/)ajax(?:&.*)?|meta\.wikimedia\.org\/w\/index\.php\?.*title=Special(?:%3A|:)BannerLoader(?:&.*)?)$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/GeneralAdBlock/wikipedia-adblock.js?v=1.0.1,tag=Wikipedia,requires-body=true,timeout=30
http-response ^https:\/\/config\.mobile\.yahoo\.com\/V3\/getconfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/GeneralAdBlock/yahoo-finance-adblock.js?v=1.0.0,tag=Yahoo Finance,requires-body=true,timeout=30
http-request ^https:\/\/config\.mobile\.yahoo\.com\/V3\/getconfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/GeneralAdBlock/yahoo-finance-adblock.js?v=1.0.0,tag=Yahoo Finance Request,timeout=30

[Mitm]
hostname = *.manhuashe.com, api.gamer.com.tw, config.mobile.yahoo.com, gql-fed.reddit.com, gql.reddit.com, legy.line-apps.com, meta.wikimedia.org, pay.macaupass.com, service.global.thim.immigration.go.th, service.thim.immigration.go.th, userside-api.mfoodapp.com, www.google.com, zh.wikipedia.org
