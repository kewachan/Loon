#!name=Youtube Enhance
#!desc=Enhancements for YouTube and YouTube Music
#!author=kewachan
#!system=iOS,iPadOS,tvOS,macOS
#!loon_version=3.5.1(988)

[Argument]
blockUpload = switch,true,tag=Block Upload Button
blockImmersive = switch,true,tag=Block Immersive Button
blockShorts = switch,false,tag=Block Shorts Button
captionLang = input,"off",tag=Caption Translation Language
lyricsLang = input,"zh-Hant",tag=Lyrics Translation Language
debug = switch,false,tag=Enable Debug Mode

[Rule]
DOMAIN,youtube-lyrics-translate.hmtw47cv7m.workers.dev,DIRECT
DOMAIN,translate.googleapis.com,DIRECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,googlevideo.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,youtubei.googleapis.com)),REJECT

[Script]
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/navigation\/resolve_url(?:\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.navigation.response.js,tag=youtube.response.navigation,requires-body=true,binary-body-mode=true,timeout=30
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.response.js?v=20260930-3,tag=youtube.response,requires-body=true,binary-body-mode=true,timeout=30,argument=[{captionLang},{blockUpload},{blockImmersive},{blockShorts},{debug}]
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(log_event|config)(\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.request.js?v=20260930-2,tag=youtube.response.config,requires-body=true,binary-body-mode=true,timeout=10
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_panel(?:\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.lyrics.js?v=20261001-2,tag=youtube.lyrics,requires-body=true,binary-body-mode=true,timeout=10,argument=[{lyricsLang},{debug}]
http-response ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.init.response.js?v=20260930-2,tag=youtube.response.init,requires-body=true,binary-body-mode=true,timeout=30,argument=[{captionLang},{debug}]
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(next|log_event|config)(\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.request.js?v=20260930-2,tag=youtube.request.config,requires-body=true,binary-body-mode=true,timeout=10
http-request ^https:\/\/www\.youtube\.com\/api\/timedtext\?(?:[^&]*&)*tlang=[^&]+(?:&|$) script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.caption.js?v=20261001-1,tag=youtube.caption.request,timeout=10
http-response ^https:\/\/www\.youtube\.com\/api\/timedtext\?(?:[^&]*&)*(?:enhance_)?tlang=[^&]+(?:&|$) script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.caption.js?v=20261001-1,tag=youtube.caption.response,requires-body=true,timeout=120

[Mitm]
hostname = *.googlevideo.com, youtubei.googleapis.com, www.youtube.com
