#!name=Youtube Enhance
#!desc=Enhancements for YouTube and YouTube Music
#!author=kewachan
#!system=iOS,iPadOS,tvOS,macOS
#!loon_version=3.5.1(983)

[Argument]
blockUpload = switch,true,tag=Block Upload Button
blockImmersive = switch,true,tag=Block Immersive Button
blockShorts = switch,false,tag=Block Shorts Button
captionLang = input,"off",tag=Caption Translation Language
debug = switch,false,tag=Enable Debug Mode

[Rule]
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,googlevideo.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,youtubei.googleapis.com)),REJECT

[Script]
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?.*)?$ script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.response.js,tag=youtube.response,requires-body=true,binary-body-mode=true,timeout=30,argument=[{captionLang},{blockUpload},{blockImmersive},{blockShorts},{debug}]
http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.request.js,tag=youtube.request.init,requires-body=true,binary-body-mode=true,timeout=30,argument=[{captionLang}]
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.request.js,tag=youtube.request.log_event,requires-body=true,binary-body-mode=true,timeout=20
http-request ^https:\/\/www\.youtube\.com\/api\/timedtext\?(?:[^&]*&)*tlang=[^&]+(?:&|$) script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.caption.js,tag=youtube.caption.request,timeout=10
http-response ^https:\/\/www\.youtube\.com\/api\/timedtext\?(?:[^&]*&)*(?:enhance_)?tlang=[^&]+(?:&|$) script-path=https://raw.githubusercontent.com/kewachan/Loon/main/Rewrite/Youtube/youtube.caption.js,tag=youtube.caption.response,requires-body=true,timeout=30

[Mitm]
hostname = *.googlevideo.com, youtubei.googleapis.com, www.youtube.com
